  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.9",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.3.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
